{
  "name": "reviewer",
  "private": true,
  "version": "0.0.10",
  "description": "Reviewer — a macOS app for understanding, editing and reviewing AI-generated code",
  "license": "MIT",
  "homepage": "https://reviewer.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darna-Digital/reviewer.git"
  },
  "bugs": {
    "url": "https://github.com/Darna-Digital/reviewer/issues"
  },
  "author": "Darna Digital (https://darnadigital.com)",
  "scripts": {
    "dev": "pnpm --parallel --filter @reviewer/embedded-server --filter spa dev",
    "dev:www": "pnpm --filter www dev",
    "dev:brand": "pnpm --filter @reviewer/brand dev",
    "dev:mac": "pnpm --filter @reviewer/mac-os dev",
    "dev:mac:watch": "pnpm --filter @reviewer/mac-os watch",
    "build:mac": "pnpm --filter spa build && pnpm --filter @reviewer/embedded-server build:bundle && pnpm --filter @reviewer/mac-os bundle",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "format:check": "pnpm -r --if-present format:check",
    "deploy:www": "pnpm --filter www run deploy"
  },
  "packageManager": "pnpm@11.7.0"
}
