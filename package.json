{
  "name": "reviewer",
  "private": true,
  "version": "0.0.1",
  "description": "reviewer.darnadigital.com — local git review tool",
  "scripts": {
    "dev": "pnpm --parallel --filter @reviewer/embedded-server --filter spa dev",
    "dev:www": "pnpm --filter www dev",
    "dev:brand": "pnpm --filter @reviewer/brand dev",
    "dev:mac": "pnpm --filter @reviewer/mac-os dev",
    "dev:mac:watch": "pnpm --filter @reviewer/mac-os watch",
    "build:mac": "pnpm --filter spa build && pnpm --filter @reviewer/embedded-server build:bundle && pnpm --filter @reviewer/mac-os bundle",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "format:check": "pnpm -r --if-present format:check",
    "deploy:www": "pnpm --filter www run deploy"
  },
  "packageManager": "pnpm@11.7.0"
}
