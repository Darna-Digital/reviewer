{
  "name": "reviewer",
  "private": true,
  "version": "0.2.7",
  "description": "reviewer.darnadigital.com — local git review tool",
  "scripts": {
    "dev": "pnpm --parallel --filter @reviewer/embedded-server --filter spa dev",
    "dev:www": "pnpm --filter www dev",
    "dev:brand": "pnpm --filter @reviewer/brand dev",
    "dev:desktop": "pnpm --parallel --filter spa --filter @reviewer/desktop dev",
    "desktop": "pnpm build:desktop && pnpm --filter @reviewer/desktop start",
    "build:desktop": "pnpm --filter @reviewer/embedded-server build:bundle && pnpm --filter spa build:desktop && pnpm --filter @reviewer/desktop build",
    "pack:desktop": "pnpm build:desktop && pnpm --filter @reviewer/desktop run pack",
    "dist:desktop": "pnpm build:desktop && pnpm --filter @reviewer/desktop run dist",
    "dev:mac": "pnpm --filter @reviewer/mac-os dev",
    "build:mac": "pnpm --filter @reviewer/mac-os bundle",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "format:check": "pnpm -r --if-present format:check",
    "deploy:www": "pnpm --filter www run deploy"
  },
  "packageManager": "pnpm@11.7.0"
}
