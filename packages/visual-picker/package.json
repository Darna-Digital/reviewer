{
  "name": "@byconvo/visual-picker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "byconvo visual picker — the dev-only script injected into a locally-running app so DOM elements can be clicked and commented on",
  "exports": {
    "./bundle": "./src/bundle.generated.ts"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@byconvo/lint": "workspace:*",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
