{
  "name": "www",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy --config dist/server/wrangler.json",
    "capture:spa": "node scripts/capture-spa/cli.ts",
    "capture:home": "node scripts/capture-spa/cli.ts --manifest scripts/capture-spa/home.json",
    "generate:og": "node scripts/og-image/render.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,css}\"",
    "typecheck": "tsc --noEmit && tsc -p scripts --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@reviewer/lint": "workspace:*",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }
}
