// The Worker behind reviewer.sh, for `pnpm dev` and for the deploy alike.
// `vite build` runs @cloudflare/vite-plugin from vite.config.ts, which reads this
// file and writes dist/server/wrangler.json beside the bundle with the built
// entry and the client assets filled in; `pnpm deploy` hands wrangler that one.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reviewer-www",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    {
      "pattern": "reviewer.sh",
      "custom_domain": true,
    },
  ],
  // The Reviewer Cloud waitlist, a D1 database. No `database_id`: `wrangler
  // deploy` creates it on first deploy and keeps it linked, and `pnpm dev`
  // keeps a local one under .wrangler/. The table is created on first use.
  "d1_databases": [
    { "binding": "WAITLIST", "database_name": "reviewer-waitlist" },
  ],
  // Turnstile guards the waitlist form, in Managed mode. The site key is
  // public; the secret is a Worker secret, `TURNSTILE_SECRET_KEY`, set in the
  // Cloudflare dashboard. `pnpm dev` always uses Cloudflare's test keys.
  "vars": { "TURNSTILE_SITE_KEY": "0x4AAAAAAF2LxJRUCXm_Y475" },
  "observability": {
    "enabled": true,
  },
}
