// The Worker behind reviewer.sh, for `pnpm dev` and for the deploy alike.
// `vite build` runs @cloudflare/vite-plugin from vite.config.ts, which reads this
// file and writes dist/server/wrangler.json beside the bundle with the built
// entry and the client assets filled in; `pnpm deploy` hands wrangler that one.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reviewer-www",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    {
      "pattern": "reviewer.sh",
      "custom_domain": true
    }
  ],
  // The Reviewer Cloud waitlist. No `id`: `wrangler deploy` creates the
  // namespace on first deploy and keeps it linked, and `pnpm dev` keeps a local
  // one under .wrangler/.
  "kv_namespaces": [{ "binding": "WAITLIST" }],
  "observability": {
    "enabled": true
  }
}
