// The Worker behind reviewer.sh, for `pnpm dev` and for the deploy alike.
// `vite build` runs @cloudflare/vite-plugin from vite.config.ts, which reads this
// file and writes dist/server/wrangler.json beside the bundle with the built
// entry and the client assets filled in; `pnpm deploy` hands wrangler that one.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reviewer-www",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "routes": [
    {
      "pattern": "reviewer.sh",
      "custom_domain": true,
    },
  ],
  // The Reviewer Cloud waitlist, a D1 database (created with `wrangler d1
  // create`). `pnpm dev` keeps a local one under .wrangler/. The table is
  // created on first use.
  "d1_databases": [
    {
      "binding": "WAITLIST",
      "database_name": "reviewer-waitlist",
      "database_id": "066aec5e-c3bb-44a3-a105-7ab8a85139b2",
    },
    // The usage rollup's daily totals (src/lib/usage-rollup.ts). No
    // `database_id`: `wrangler deploy` creates it on the first deploy.
    {
      "binding": "USAGE_DB",
      "database_name": "reviewer-usage",
    },
  ],
  // Turnstile guards the waitlist form, in Managed mode. The site key is
  // public; the secret is a Worker secret, `TURNSTILE_SECRET_KEY`, set in the
  // Cloudflare dashboard. `pnpm dev` always uses Cloudflare's test keys.
  "vars": { "TURNSTILE_SITE_KEY": "0x4AAAAAAF2LxJRUCXm_Y475" },
  "observability": {
    "enabled": true,
  },
  // Usage, counted from the apps' update checks (src/lib/usage.ts), and kept
  // past Analytics Engine's three months by the daily rollup into the
  // USAGE_DB database above (src/lib/usage-rollup.ts). The rollup reads the
  // dataset through the SQL API, with the secrets CF_ACCOUNT_ID and
  // ANALYTICS_API_TOKEN, which deploy-www.yml uploads from the repository's
  // GitHub secrets.
  "analytics_engine_datasets": [
    {
      "binding": "USAGE",
      "dataset": "reviewer_usage",
    },
  ],
  "triggers": {
    "crons": ["0 3 * * *"],
  },
}
