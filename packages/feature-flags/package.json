{
  "name": "@byconvo/feature-flags",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "byconvo feature flags — one switch per feature, read wherever the feature is surfaced",
  "exports": {
    ".": "./src/feature-flags.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,js}\"",
    "format:check": "prettier --check \"**/*.{ts,js}\""
  },
  "devDependencies": {
    "@byconvo/lint": "workspace:*",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  }
}
