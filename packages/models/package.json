{
  "name": "@byconvo/models",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "byconvo shared feature models — Effect Schemas as the single source of truth, imported by the server (runtime validation) and the SPA (inferred types)",
  "exports": {
    "./workspace": "./src/workspace.ts",
    "./repo": "./src/repo.ts",
    "./comments": "./src/comments.ts",
    "./github": "./src/github.ts",
    "./git-message": "./src/git-message.ts",
    "./threads": "./src/threads.ts",
    "./chats": "./src/chats.ts",
    "./docs": "./src/docs.ts",
    "./tasks": "./src/tasks.ts",
    "./local-dev": "./src/local-dev.ts",
    "./api": "./src/api.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "effect": "4.0.0-beta.74"
  },
  "devDependencies": {
    "@byconvo/lint": "workspace:*",
    "eslint": "^9",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
