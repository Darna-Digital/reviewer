{
  "name": "@reviewer/lint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared oxlint and oxfmt rules for reviewer.sh",
  "files": [
    ".oxlintrc.json",
    ".oxfmtrc.json"
  ],
  "scripts": {
    "lint": "cd ../.. && oxlint -c packages/lint/.oxlintrc.json",
    "lint:fix": "cd ../.. && oxlint -c packages/lint/.oxlintrc.json --fix",
    "format": "cd ../.. && oxfmt -c packages/lint/.oxfmtrc.json --ignore-path .gitignore --ignore-path packages/lint/.oxfmtignore 'packages/**/*.{ts,tsx,js,jsx,css}'",
    "format:check": "cd ../.. && oxfmt -c packages/lint/.oxfmtrc.json --ignore-path .gitignore --ignore-path packages/lint/.oxfmtignore 'packages/**/*.{ts,tsx,js,jsx,css}' --check"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0"
  }
}
