{
  "name": "@byconvo/lint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared ESLint and Prettier rules for byconvo.com",
  "exports": {
    "./eslint": "./eslint.config.js",
    "./prettier": "./prettier.config.js"
  },
  "files": [
    "eslint.config.js",
    "prettier.config.js"
  ],
  "scripts": {
    "format": "prettier --write \"*.js\"",
    "format:check": "prettier --check \"*.js\""
  },
  "dependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  }
}
