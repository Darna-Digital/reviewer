{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "overrides": [
    {
      // The TUI follows the tRPC house style rather than the rest of the repo.
      "files": ["**/packages/tui/**"],
      "options": {
        "singleQuote": true,
        "trailingComma": "all"
      }
    },
    {
      // Replaces prettier-plugin-tailwindcss. Stylesheet paths resolve against
      // this file, so each package's entry points back out of packages/lint.
      "files": ["**/packages/brand/**"],
      "options": {
        "sortTailwindcss": {
          "stylesheet": "../brand/src/styles.css",
          "functions": ["cn"]
        }
      }
    },
    {
      "files": ["**/packages/spa/**"],
      "options": {
        "sortTailwindcss": {
          "stylesheet": "../spa/src/styles.css",
          "functions": ["cn", "cva"]
        }
      }
    },
    {
      "files": ["**/packages/www/**"],
      "options": {
        "sortTailwindcss": {
          "stylesheet": "../www/src/styles.css"
        }
      }
    }
  ]
}
