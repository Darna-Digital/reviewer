{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "promise", "node"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    // The new JSX transform needs no React in scope.
    "react/react-in-jsx-scope": "off",

    // The two hook rules the ESLint setup enforced before the move to oxlint.
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",

    // The rest of oxlint's `react` correctness tier is the React Compiler
    // ruleset, which this codebase has never been written against. Leaving it
    // on would bury the two rules above under hundreds of pre-existing hits.
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/preserve-manual-memoization": "off",
    "react/static-components": "off",
    "react/globals": "off",
    "react/immutability": "off",
    "react/use-memo": "off",
    "react/purity": "off",
    "react/memo-dependencies": "off",
    "react/no-deriving-state-in-effects": "off",
    "react/exhaustive-effect-dependencies": "off",

    // Effect.gen generators legitimately may not `yield`.
    "eslint/require-yield": "off",

    // `for (const x of [...collection])` is the snapshot idiom used here when
    // the body deletes from that collection or dispatches to listeners that
    // unsubscribe; the spread is load-bearing, not redundant.
    "unicorn/no-useless-spread": "off",

    // Settling a caller's callback inside `then`/`catch` is the shape the TUI
    // and the editor host both use to bridge promises to their callback APIs.
    "promise/no-callback-in-promise": "off",

    // Vite's `?worker` and `?url` imports resolve to a default export only
    // once Vite has transformed them, which the resolver does not see.
    "import/default": "off"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/src/routeTree.gen.ts",
    "**/src/lib/api/schema.d.ts",
    "**/packages/visual-picker/src/bundle.generated.ts",
    "**/packages/www/scripts/capture-spa/prepare/**"
  ],
  "overrides": [
    {
      // The browser's own dialogs look nothing like the app, put their buttons
      // in the platform's order rather than ours, and block the renderer while
      // they are up — which in the desktop shell freezes the window.
      "files": ["**/packages/spa/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "alert",
            "message": "Use toast() from sonner, or confirm() from @/components/ui/alerts."
          },
          {
            "name": "confirm",
            "message": "Use confirm() from @/components/ui/alerts."
          },
          {
            "name": "prompt",
            "message": "Use askForText() from @/components/ui/alerts."
          }
        ]
      }
    }
  ]
}
