{
  "name": "@byconvo/embedded-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "byconvo embedded-server — an API server embedded alongside the app (desktop, or bundled with a host); Effect backend (darna-stack pattern), git/filesystem-backed",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "build:bundle": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/main.cjs --sourcemap --external:@lydell/node-pty",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,js}\"",
    "format:check": "prettier --check \"**/*.{ts,js}\""
  },
  "dependencies": {
    "@byconvo/core": "workspace:*",
    "@effect/platform-node": "4.0.0-beta.74",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@types/ws": "^8.18.1",
    "effect": "4.0.0-beta.74",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@byconvo/lint": "workspace:*",
    "@effect/vitest": "4.0.0-beta.74",
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
