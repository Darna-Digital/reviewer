{
  "name": "@reviewer/core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "reviewer infra-agnostic core — feature schemas, services, and in-memory repositories shared by the server and the SPA",
  "exports": {
    "./ports/*": "./src/ports/*.ts",
    "./shared": "./src/shared.ts",
    "./*": "./src/features/*/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,js}\"",
    "format:check": "prettier --check \"**/*.{ts,js}\""
  },
  "dependencies": {
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.115",
    "@reviewer/lint": "workspace:*",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
