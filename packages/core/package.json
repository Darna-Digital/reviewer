{
  "name": "@reviewer/core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "reviewer infra-agnostic core \u2014 feature schemas, services, and in-memory repositories shared by the server and the SPA",
  "exports": {
    "./ports/*": "./src/ports/*.ts",
    "./shared": "./src/shared.ts",
    "./*": "./src/features/*/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pierre/theme": "2.0.0",
    "@pierre/theming": "1.0.2",
    "@shikijs/themes": "4.5.0",
    "effect": "4.0.6",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
