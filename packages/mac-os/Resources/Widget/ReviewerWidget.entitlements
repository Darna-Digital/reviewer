<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- An app extension has to be sandboxed on macOS: PlugInKit refuses to
	     register one that is not, and the widget host then cannot find it
	     at all. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The group container is where a properly signed build shares the
	     project feed with the app. A signature without a team identifier —
	     a local build has none — is not granted it, and the sandbox
	     refuses the file; see ProjectFeed for what the app writes then. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>S89963CMRN.com.byconvo.reviewer</string>
	</array>
	<!-- The other copy of the feed, in ~/.reviewer beside the server's own
	     state, which this exception is what lets the extension read. It is
	     the whole of the sandbox's opening: one folder, read-only, and the
	     app writes it as an ordinary file in the home folder — where the
	     feed used to go instead was this extension's sandbox container,
	     which macOS counts as another app's data and gates behind the
	     "access data from other apps" dialog. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/.reviewer/</string>
	</array>
</dict>
</plist>
