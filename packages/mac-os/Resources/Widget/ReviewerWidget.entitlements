<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- An app extension has to be sandboxed on macOS: PlugInKit refuses to
	     register one that is not, and the widget host then cannot find it
	     at all. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The group container is where a properly signed build shares the
	     project feed with the app. A signature without a team identifier —
	     this app is signed ad-hoc — is not granted it, and the sandbox
	     refuses the file; see ProjectFeed for what the app writes then. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.byconvo.reviewer</string>
	</array>
</dict>
</plist>
