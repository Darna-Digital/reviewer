<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Reviewer</string>
	<key>CFBundleIdentifier</key>
	<string>com.byconvo.reviewer.macos</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Reviewer</string>
	<key>CFBundleDisplayName</key>
	<string>Reviewer</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleIconFile</key>
	<string>Reviewer</string>
	<key>CFBundleIconName</key>
	<string>Reviewer</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- reviewer://open?path=… — how the widget opens a project here (see
	     ProjectLink). Launch Services brings the app up, or forward, and
	     hands it the URL. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.byconvo.reviewer.macos.open</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>reviewer</string>
			</array>
			<key>LSHandlerRank</key>
			<string>Owner</string>
		</dict>
	</array>
	<!-- The API server is plain http on the loopback interface. ATS already
	     exempts literal IP addresses, which is why the client dials 127.0.0.1
	     rather than localhost; this keeps `.local`/unqualified hosts open too. -->
	<!-- Sparkle (see UpdateCheck). The feed is the appcast.xml release.yml
	     attaches to every GitHub release; /latest/ follows the newest one.
	     The public key checks the disk image the feed names — its private
	     half is the SPARKLE_PRIVATE_KEY secret, and the "reviewer" account
	     in the release manager's login keychain (generate_keys -x exports it).
	     bundle.sh turns the scheduled checks off for debug builds. -->
	<key>SUFeedURL</key>
	<string>https://github.com/Darna-Digital/reviewer/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>jdNd/hL5GdeFe51aOmF/5GID01GZkUWjE8c42Ao8EnA=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>21600</integer>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
