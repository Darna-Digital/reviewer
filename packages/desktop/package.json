{
  "name": "@byconvo/desktop",
  "productName": "Byconvo",
  "private": true,
  "version": "0.1.0",
  "description": "byconvo desktop — Electron shell around the client",
  "main": "dist/main.js",
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "electron-updater": "6.8.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pack": "electron-builder --dir --config electron-builder.config.js",
    "dist": "electron-builder --config electron-builder.config.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && BYCONVO_DESKTOP_DEV=1 electron .",
    "start": "tsc -p tsconfig.json && electron .",
    "format": "prettier --write \"src/**/*.ts\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.js\""
  },
  "devDependencies": {
    "@byconvo/lint": "workspace:*",
    "@types/node": "^22.20.1",
    "electron": "^43.6.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  }
}
