{
  "compilerOptions": {
    "target": "ES2022",
    // "Node" selected the `node10` resolver, which TypeScript 6 rejects
    // outright and 7 has removed. `node16` is its supported successor, and it
    // requires the matching module setting. The package declares no `"type"`,
    // so Node16 still emits CommonJS — which is what Electron loads this
    // `main` as.
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2023"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src"]
}
