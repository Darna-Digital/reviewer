#!/usr/bin/env bash
# Prepares an Amp orb for working on packages/www (reviewer.sh).
# The macOS app and the TUI are not set up here yet.
set -euo pipefail

cd "$(dirname "$0")/.."

step() {
  local name="$1"
  shift
  echo "==> $name"
  local start=$SECONDS
  "$@"
  echo "<== $name ($((SECONDS - start))s)"
}

# package.json pins pnpm through `packageManager`; corepack provides that exact
# version when the orb's preinstalled pnpm differs.
ensure_pnpm() {
  local want
  want="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
  if [[ "$(pnpm --version 2>/dev/null || true)" != "$want" ]]; then
    corepack enable
    corepack prepare "pnpm@$want" --activate
  fi
  pnpm --version
}

step "pnpm" ensure_pnpm
# Only www and its workspace dependencies; pnpm skips the work when the
# restored node_modules already match the lockfile.
step "install www" pnpm install --frozen-lockfile --filter 'www...'
